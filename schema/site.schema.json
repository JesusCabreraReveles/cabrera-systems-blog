{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"title": {
			"type": "string",
			"minLength": 1
		},
		"tagline": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"minLength": 1
				},
				"es": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": false
		},
		"baseUrl": {
			"type": "string",
			"format": "uri",
			"description": "Canonical base, no trailing slash"
		},
		"languages": {
			"default": [
				"en",
				"es"
			],
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"en",
					"es"
				]
			}
		},
		"author": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"url": {
					"type": "string",
					"format": "uri"
				}
			},
			"required": [
				"name",
				"url"
			],
			"additionalProperties": false
		},
		"social": {
			"type": "object",
			"properties": {
				"x": {
					"type": "string",
					"pattern": "^\\w{1,15}$"
				}
			},
			"required": [
				"x"
			],
			"additionalProperties": false
		},
		"links": {
			"default": [],
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					},
					"label": {
						"type": "object",
						"properties": {
							"en": {
								"type": "string",
								"minLength": 1
							},
							"es": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"en",
							"es"
						],
						"additionalProperties": false
					},
					"url": {
						"type": "string",
						"format": "uri"
					}
				},
				"required": [
					"id",
					"label",
					"url"
				],
				"additionalProperties": false
			}
		},
		"tags": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					},
					"label": {
						"type": "object",
						"properties": {
							"en": {
								"type": "string",
								"minLength": 1
							},
							"es": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"en",
							"es"
						],
						"additionalProperties": false
					}
				},
				"required": [
					"id",
					"label"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"title",
		"tagline",
		"baseUrl",
		"author",
		"social",
		"tags"
	],
	"additionalProperties": false,
	"$id": "https://cabrera.systems/blog/schema/site.schema.json",
	"title": "src/content/site.yaml"
}
